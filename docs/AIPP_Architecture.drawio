<mxfile host="app.diagrams.net" agent="AIPP" version="24.7.17">
  <diagram name="AIPP Architecture" id="aipp-arch-1">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="AIPP — Multi-Agent System Architecture &amp; AI-Ops Control Tower" style="text;html=1;fontSize=24;fontStyle=1;align=center;fontColor=#1F3A8A;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- User Actor -->
        <mxCell id="user" value="DevOps / SRE&#10;Platform Engineer" style="shape=umlActor;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="70" height="90" as="geometry" />
        </mxCell>

        <!-- Control Tower UI -->
        <mxCell id="ui" value="AIPP Control Tower (8 Tabs)&#10;1. Generator · 2. Doctor (RCA) · 3. n8n Workflows · 4. Slack HITL&#10;5. Audit &amp; Compliance · 6. Batch Repo Runner · 7. Compare Mode · 8. FinOps Meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="215" width="580" height="65" as="geometry" />
        </mxCell>

        <!-- Live n8n Engine -->
        <mxCell id="n8n_box" value="n8n Workflow Engine (20 Active Workflows)&#10;https://n8n.dccloud.in.net&#10;Error Sink · Drift · K8s Health · RCA SOP Gen · Rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="215" width="400" height="65" as="geometry" />
        </mxCell>

        <!-- FastAPI Backend Container -->
        <mxCell id="backend" value="AIPP FastAPI Backend Core (/api/* + SSE Event Stream + Directive Parser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="1040" height="460" as="geometry" />
        </mxCell>

        <!-- 8 Agents Container -->
        <mxCell id="agents" value="8 Specialized Agents (LangGraph Stateful StateMachine)&#10;&#10;1. Repository Analysis Agent (heuristic inspection)&#10;2. Technology Detection Agent (runtime &amp; build tools)&#10;3. Architecture Detection Agent (monolith/microservice/monorepo)&#10;4. Pipeline Planning Agent (DAG stage dependency planner)&#10;5. Environment Deployment Agent (multi-stage approval gating)&#10;6. Pipeline Generation Agent (deterministic AST/YAML renderer)&#10;7. Pipeline Validation Agent (4 gates + Self-Healing JSON engine)&#10;8. Pipeline Doctor / RCA Agent (log grounding + 1536-d vector RCA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="390" width="460" height="250" as="geometry" />
        </mxCell>

        <!-- PostgreSQL Database & pgvector -->
        <mxCell id="pg" value="PostgreSQL 15 + pgvector&#10;&#10;• audit_logs (append-only ledger)&#10;• pipeline_runs (execution state)&#10;• rca_reports (structured post-mortems)&#10;• rca_embeddings (1536-d cosine memory)&#10;• research_experiments (20-repo benchmarks)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=15;verticalAlign=top;spacingTop=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="390" width="460" height="250" as="geometry" />
        </mxCell>

        <!-- MCP Adapters Layer -->
        <mxCell id="mcp" value="11 MCP Adapters (Model Context Protocol)&#10;GitHub · GitLab · Azure DevOps · Harness · Tekton · Kubernetes · AWS · Azure · GCP · n8n · Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="670" width="970" height="60" as="geometry" />
        </mxCell>

        <!-- Inputs Container -->
        <mxCell id="inputs" value="INPUTS&#10;• Public Git Repo URL&#10;• Target CI/CD Platform&#10;• Target Cloud Provider&#10;• Pipeline Scope Directive&#10;• Custom Free-form Prompt&#10;• Failing Logs (for RCA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
