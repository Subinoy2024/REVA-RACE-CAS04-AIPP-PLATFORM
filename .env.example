# ==============================================================================
# AIPP — Environment Configuration Template
# Copy this file to .env and fill in appropriate values.
# ==============================================================================

# --- Database Credentials -----------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://aipp:aipp_local@127.0.0.1:5432/aipp
POSTGRES_SYNC_URL=postgresql+psycopg2://aipp:aipp_local@127.0.0.1:5432/aipp

# --- Security & Authentication ------------------------------------------------
JWT_SECRET=aipp-dev-secret-please-override-in-prod-64-chars-of-entropy
AIPP_FERNET_KEY=
AIPP_DEFAULT_ADMIN_EMAIL=admin@dccloud.in.net
AIPP_DEFAULT_ADMIN_PASSWORD=aipp-change-me

# --- LLM Provider Settings ----------------------------------------------------
# Universal key (works for Anthropic / OpenAI / Gemini depending on provider)
AIPP_LLM_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Vendor-specific keys (alternative to AIPP_LLM_KEY)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- n8n Workflow Integration (Optional) --------------------------------------
N8N_BASE_URL=
N8N_API_KEY=

# --- CI/CD MCP Adapters (Optional) --------------------------------------------
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITHUB_ACTIONS_TOKEN=
HARNESS_BASE_URL=https://app.harness.io
HARNESS_ACCOUNT_ID=
HARNESS_API_KEY=
KUBECONFIG=

# --- Cloud Provider MCP Adapters (Optional) ----------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Service & CORS Settings --------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=*
AIPP_INTERNAL_BACKEND_URL=http://127.0.0.1:8001
MAX_LOG_UPLOAD_BYTES=5000000
