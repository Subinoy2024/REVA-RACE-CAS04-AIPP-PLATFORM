# ==============================================================================
# AIPP · n8n Config  (iteration-35 · Community-edition compatible)
# ==============================================================================
# n8n Community edition does NOT support the Variables API — that's an
# Enterprise-only feature. So we inline config values at BUILD TIME:
#
#   1. Fill in the values below
#   2. Run:  python3 build_workflows.py    (reads THIS file, bakes into JSONs)
#   3. Run:  bash scripts/deploy.sh         (pushes JSONs to n8n via API)
#
# The generated JSON files (workflows/*.json) are gitignored because they
# contain the baked AIPP_API_KEY and (optionally) AZURE_CLIENT_SECRET /
# SLACK_SIGNING_SECRET. Never commit them.
#
# All real infra credentials (K8S_TOKEN, GITHUB_PAT, PROXMOX_TOKEN,
# GRAFANA_API_KEY, ADO_PAT, GH_REPO_ALLOWLIST) live in AIPP backend's `.env`
# — this file only holds what n8n itself needs to reach AIPP.
# ==============================================================================


# ---- AIPP proxy (the ONLY infra secret n8n needs) --------------------------
AIPP_BASE_URL=https://aipp.dccloud.in.net
AIPP_API_KEY=

# ---- Slack channels --------------------------------------------------------
# Every workflow posts to Slack. A single-channel workspace can leave every
# variable at `aipp`; separate channels are recommended in production.
SLACK_CHANNEL_DEFAULT=aipp
SLACK_CHANNEL_ALERTS=aipp
SLACK_CHANNEL_APPROVALS=aipp
SLACK_CHANNEL_DIGEST=aipp
# Slack app → Basic Information → Signing Secret. Leave blank in dev; with
# a value set, Slack-triggered webhooks verify the X-Slack-Signature HMAC.
SLACK_SIGNING_SECRET=

# ---- Repo hints used by GitHub/IaC workflow LLM prompts --------------------
# NOT secrets — just names the LLM references to shape output. Allowlist
# enforcement now lives INSIDE the AIPP proxy (`GH_REPO_ALLOWLIST` on
# AIPP's .env), so a compromised n8n cannot bypass it.
GH_ORG=Subinoy2024
GH_REPO=AIPP-AI-Driven-Pipeline-Platform-RACE
IAC_REPO_OWNER=Subinoy2024
IAC_REPO_NAME=AIPP-AI-Driven-Pipeline-Platform-RACE

# ---- Azure (still direct — OAuth client_credentials) ----------------------
# These MUST stay on n8n because Azure APIs return short-lived tokens the
# proxy would have to refresh on every call. Leave blank to skip #09/#12/#13/#15.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RG_DEFAULT=aipp-prod-rg
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# ---- Service-ownership map (used by #10 Incident Commander LLM) -----------
SVCMAP={"api-*":"backend-team","web-*":"frontend-team","payments-*":"platform"}


# ==============================================================================
# What moved OUT of this file (now lives on AIPP backend .env):
#   K8S_API_URL, K8S_TOKEN, K8S_CA_VERIFY,
#   PROXMOX_URL, PROXMOX_TOKEN, PROXMOX_NODE, PROXMOX_VERIFY_SSL,
#   GRAFANA_URL, GRAFANA_API_KEY, PROMETHEUS_URL,
#   GITHUB_PAT, GH_REPO_ALLOWLIST,
#   ADO_ORG, ADO_PROJECT, ADO_PAT,
#   PROXY_API_KEY   ← the AIPP-side pair to AIPP_API_KEY above.
# ==============================================================================
