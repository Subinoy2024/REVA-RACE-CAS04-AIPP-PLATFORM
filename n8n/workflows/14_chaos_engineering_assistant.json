{
  "name": "AIPP \u00b7 14 \u00b7 Chaos Engineering Assistant",
  "nodes": [
    {
      "parameters": {
        "path": "aipp-chaos-experiment-request",
        "formTitle": "AIPP Chaos \u2014 Experiment Request",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Question to answer",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Target namespace",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Requester",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      },
      "id": "f99fc336-9514-558c-9072-c78b5c506cd6",
      "name": "Chaos Request Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "trace-1",
              "name": "traceId",
              "value": "={{ $execution.id + '-' + $now.toMillis() }}",
              "type": "string"
            },
            {
              "id": "trace-2",
              "name": "startedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "trace-3",
              "name": "workflow",
              "value": "={{ $workflow.name }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c18701e8-2c18-5943-a28a-1303e392fe22",
      "name": "Init Trace",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        380,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You design SAFE chaos experiments. Output ONLY a raw JSON object (no markdown). Schema: {\"hypothesis\":\"<line>\", \"chaos_mesh_manifest\":\"<yaml>\", \"blast_radius\":\"<pod|node|zone>\", \"duration_min\":<int>, \"abort_conditions\":[\"cond1\"]}. Cap duration at 30 min."
            },
            {
              "role": "user",
              "content": "Question: {{$json['Question to answer']}}\nNamespace: {{$json['Target namespace']}}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "554b513a-6c1d-5f91-93e2-23f8685ccae2",
      "name": "AI \u00b7 Design Experiment",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        560,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ai-parse",
              "name": "ai",
              "value": "={{ JSON.parse($json.message?.content || $json.content || $json.text || '{}') }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "bf53a90c-beb1-5e66-8bb1-279a4dbcaaa2",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "jsonParameters": true,
        "blocks": "=[{\"type\": \"header\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\ud83e\\uddea  Chaos Experiment \\u2014 Approval Needed\", \"emoji\": true}}, {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": \"\\u2022 *Requester:*  `{{$('Chaos Request Form').item.json['Requester']}}`\\n\\u2022 *Namespace:*  `{{$('Chaos Request Form').item.json['Target namespace']}}`\\n\\u2022 *Hypothesis:*  {{$json.ai.hypothesis || 'n/a'}}\\n\\u2022 *Blast radius:*  `{{$json.ai.blast_radius || 'n/a'}}`\\n\\u2022 *Duration:*  `{{$json.ai.duration_min || '?'}} min`\\n\\u2022 *Abort conditions:*  {{JSON.stringify($json.ai.abort_conditions || [])}}\"}}, {\"type\": \"actions\", \"block_id\": \"aipp_hitl_approval\", \"elements\": [{\"type\": \"button\", \"action_id\": \"approve\", \"style\": \"primary\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u2705  Approve\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\", \"confirm\": {\"title\": {\"type\": \"plain_text\", \"text\": \"Confirm approval\"}, \"text\": {\"type\": \"mrkdwn\", \"text\": \"This will resume the parked n8n execution and apply the proposed change. Continue?\"}, \"confirm\": {\"type\": \"plain_text\", \"text\": \"Yes, apply\"}, \"deny\": {\"type\": \"plain_text\", \"text\": \"Cancel\"}}}, {\"type\": \"button\", \"action_id\": \"reject\", \"style\": \"danger\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u274c  Reject\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\"}]}, {\"type\": \"context\", \"elements\": [{\"type\": \"mrkdwn\", \"text\": \"Buttons require the AIPP Slack bridge \\u2014 if a click does nothing, fall back to the resume link below.\"}]}]",
        "text": "=*\ud83e\uddea  Chaos Experiment \u2014 Approval Needed*\n\n\u2022 *Requester:*  `{{$('Chaos Request Form').item.json['Requester']}}`\n\u2022 *Namespace:*  `{{$('Chaos Request Form').item.json['Target namespace']}}`\n\u2022 *Hypothesis:*  {{$json.ai.hypothesis || 'n/a'}}\n\u2022 *Blast radius:*  `{{$json.ai.blast_radius || 'n/a'}}`\n\u2022 *Duration:*  `{{$json.ai.duration_min || '?'}} min`\n\u2022 *Abort conditions:*  {{JSON.stringify($json.ai.abort_conditions || [])}}\n\n\ud83d\udc64 *Sign-off \u2014 one click:*\n\u2022 \u2705 <{{$execution.resumeUrl}}&a=approve|APPROVE \u2014 apply the fix>\n\u2022 \u274c <{{$execution.resumeUrl}}&a=reject|REJECT \u2014 do nothing>\n_Waits up to 24h for your decision._\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "unfurlLinks": false,
          "unfurlMedia": false
        }
      },
      "id": "d80c14d1-beba-5074-ba56-d0014ea78174",
      "name": "Slack \u00b7 Ask Chaos Approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        740,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "GET",
        "responseCode": 200,
        "responseMode": "onReceived",
        "responseData": "Approval recorded \u2014 you can close this tab.",
        "limitWaitTime": false,
        "options": {}
      },
      "id": "22204cf7-168e-54d0-b013-9f78018295f5",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        920,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "dec-1",
              "name": "decision",
              "value": "={{ ($json.headers?.['user-agent'] || '').toLowerCase().includes('slackbot') ? 'slackbot_ignore' : ($json.query?.a || $json.body?.a || $json.params?.a || $json.a || 'reject').toString().toLowerCase() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "12b609d3-7f51-5383-bc75-2a31571814ec",
      "name": "Normalize Decision",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if-eq",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "approve",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "6bbdb892-826f-5495-a664-9f0cc405aa27",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "text": "=\u2705 *Chaos experiment approved & launched*\nNamespace: `{{$('Chaos Request Form').item.json['Target namespace']}}`\nDuration: `{{$('Parse AI Output').item.json.ai.duration_min || '?'}} min`\nManifest queued for Chaos Mesh submission.\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "d45d1cf0-1223-5dfa-bb99-5e3533037953",
      "name": "Slack \u00b7 Chaos Kicked Off",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1280,
        200
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "text": "=\u274c *Chaos experiment rejected \u2014 no action taken*\nRequester: `{{$('Chaos Request Form').item.json['Requester']}}`\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "8cba614e-d37d-5966-b4b3-7ad039014d85",
      "name": "Slack \u00b7 Chaos Rejected",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1280,
        400
      ],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
