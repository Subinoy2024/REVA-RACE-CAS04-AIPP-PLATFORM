    {
      "parameters": {
        "content": "**Slack Signature Verification**\n\nFor a fully no-code flow we harden at ingress:\n\u2022 Cloudflare IP allowlist \u2192 only Slack IPs\n\u2022 HTTPS-only webhook (auto)\n\u2022 AIPP_API_KEY bearer required by proxy\n\nIf you need HMAC verification, add a Code node here\nor use n8n's built-in Slack Trigger node.",
        "height": 220,
        "width": 320,
        "color": 4
      },
      "id": "fc580e50-6ceb-50ec-bded-427bb7373f02",
      "name": "\ud83d\udec8 Slack Security Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1.0,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "trace-1",
              "name": "traceId",
              "value": "={{ $execution.id + '-' + $now.toMillis() }}",
              "type": "string"
            },
            {
              "id": "trace-2",
              "name": "startedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "trace-3",
              "name": "workflow",
              "value": "={{ $workflow.name }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c18701e8-2c18-5943-a28a-1303e392fe22",
      "name": "Init Trace",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "sc-1",
              "name": "pod",
              "value": "={{ (($json.body?.text || $json.text || '').match(/pod=(\\S+)/) || [])[1] || '' }}",
              "type": "string"
            },
            {
              "id": "sc-2",
              "name": "ns",
              "value": "={{ (($json.body?.text || $json.text || '').match(/ns=(\\S+)/) || [])[1] || 'default' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "91d0fe0b-44ce-5ad5-b6a7-f37d33db8ee7",
      "name": "Parse Slack Command",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        740,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "pod-req",
              "leftValue": "={{ $json.pod }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e1014ca6-9530-5165-99cd-8a1b0217c56f",
      "name": "Require Pod Arg",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=http://192.168.88.22:30801/api/proxy/k8s/pods/{{$json.ns}}/{{$json.pod}}",
        "method": "GET",
        "sendBody": false,
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer AMS2zaOxP9t4aMgsn0IcMsKjOx3EkcvEOrIC_H61SXvD4gborHjoH4pJjieedloP"
            }
          ]
        }
      },
      "id": "b029b05e-75c8-5a3c-b254-5e8a6e8eade1",
      "name": "K8s \u00b7 Fetch Pod",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "sp-1",
              "name": "phase",
              "value": "={{ $json.status?.phase || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "sp-2",
              "name": "created_at",
              "value": "={{ $json.metadata?.creationTimestamp || 'n/a' }}",
              "type": "string"
            },
            {
              "id": "sp-3",
              "name": "node_name",
              "value": "={{ $json.spec?.nodeName || 'n/a' }}",
              "type": "string"
            },
            {
              "id": "sp-4",
              "name": "images",
              "value": "={{ ($json.spec?.containers || []).map(c => `${c.name} <- ${c.image}`).join(', ') }}",
              "type": "string"
            },
            {
              "id": "sp-5",
              "name": "restart_count",
              "value": "={{ ($json.status?.containerStatuses || []).reduce((sum, cs) => sum + (cs.restartCount || 0), 0) }}",
              "type": "number"
            },
            {
              "id": "sp-6",
              "name": "ready_containers",
              "value": "={{ ($json.status?.containerStatuses || []).filter(cs => cs.ready).length + '/' + ($json.status?.containerStatuses || []).length }}",
              "type": "string"
            },
            {
              "id": "sp-7",
              "name": "container_state",
              "value": "={{ ($json.status?.containerStatuses || []).map(cs => cs.name + ':' + Object.keys(cs.state || {})[0]).join(', ') }}",
              "type": "string"
            },
            {
              "id": "sp-8",
              "name": "last_termination_reason",
              "value": "={{ ($json.status?.containerStatuses || []).map(cs => cs.lastState?.terminated?.reason).filter(Boolean).join(', ') || 'none' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "3c9cabaf-7948-57fe-8866-ef7acef649b6",
      "name": "Summarise Pod",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1060,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a K8s SRE assistant. Output ONLY a raw JSON object (no markdown, no code fence, no explanation, no prose). Schema: {\"category\":\"OOMKill|CrashLoop|ImagePullBackOff|Config|Healthy|Other\", \"root_cause\":\"<short sentence>\", \"fix_command\":\"<one kubectl command>\", \"impact\":\"<one line business impact>\", \"confidence\":<number 0-1>}. If the pod looks healthy (Running, 0 restarts, all ready), set category=Healthy, fix_command=\"no action needed\"."
            },
            {
              "role": "user",
              "content": "Pod: {{$json.pod}}  Namespace: {{$json.ns}}\nPhase: {{$json.phase}}  Ready: {{$json.ready_containers}}  Restarts: {{$json.restart_count}}\nContainer state: {{$json.container_state}}\nLast termination reason: {{$json.last_termination_reason}}\nImages: {{$json.images}}\nCreated: {{$json.created_at}}  Node: {{$json.node_name}}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "df9be6d9-0a69-5ac6-a025-ac3effdd3e70",
      "name": "AI \u00b7 Diagnose",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        1220,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ai-parse",
              "name": "ai",
              "value": "={{ JSON.parse($json.message?.content || $json.content || $json.text || '{}') }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "bf53a90c-beb1-5e66-8bb1-279a4dbcaaa2",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1380,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "jsonParameters": true,
        "blocks": "=[{\"type\": \"header\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\ud83e\\ude7a  K8s Troubleshoot \\u2014 Approval Needed\", \"emoji\": true}}, {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": \"*Pod*  `{{$('Parse Slack Command').item.json.pod}}` \\u00b7 *Namespace*  `{{$('Parse Slack Command').item.json.ns}}`\\n*Node*  `{{$('Summarise Pod').item.json.node_name}}` \\u00b7 *Phase*  `{{$('Summarise Pod').item.json.phase}}`\\n*Ready*  `{{$('Summarise Pod').item.json.ready_containers}}` \\u00b7 *Restarts*  `{{$('Summarise Pod').item.json.restart_count}}`\\n*State*  {{$('Summarise Pod').item.json.container_state}}\\n*Last term.*  `{{$('Summarise Pod').item.json.last_termination_reason}}`\\n*Images*  {{$('Summarise Pod').item.json.images}}\\n\\n\\ud83e\\udd16 *AI diagnosis*\\n\\u2022 *Category:*  `{{$json.ai.category || 'n/a'}}` (confidence `{{$json.ai.confidence || 'n/a'}}`)\\n\\u2022 *Root cause:*  {{$json.ai.root_cause || 'n/a'}}\\n\\u2022 *Impact:*  {{$json.ai.impact || 'n/a'}}\\n\\u2022 *Proposed fix:*  `{{$json.ai.fix_command || 'n/a'}}`\\n\\n_Waits up to 24h for your decision._\"}}, {\"type\": \"actions\", \"block_id\": \"aipp_hitl_approval\", \"elements\": [{\"type\": \"button\", \"action_id\": \"approve\", \"style\": \"primary\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u2705  Approve\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\", \"confirm\": {\"title\": {\"type\": \"plain_text\", \"text\": \"Confirm approval\"}, \"text\": {\"type\": \"mrkdwn\", \"text\": \"This will resume the parked n8n execution and apply the proposed change. Continue?\"}, \"confirm\": {\"type\": \"plain_text\", \"text\": \"Yes, apply\"}, \"deny\": {\"type\": \"plain_text\", \"text\": \"Cancel\"}}}, {\"type\": \"button\", \"action_id\": \"reject\", \"style\": \"danger\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u274c  Reject\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\"}]}, {\"type\": \"context\", \"elements\": [{\"type\": \"mrkdwn\", \"text\": \"Buttons require the AIPP Slack bridge \\u2014 if a click does nothing, fall back to the resume link below.\"}]}]",
        "text": "=*\ud83e\ude7a  K8s Troubleshoot \u2014 Approval Needed*\n\n*Pod*  `{{$('Parse Slack Command').item.json.pod}}` \u00b7 *Namespace*  `{{$('Parse Slack Command').item.json.ns}}`\n*Node*  `{{$('Summarise Pod').item.json.node_name}}` \u00b7 *Phase*  `{{$('Summarise Pod').item.json.phase}}`\n*Ready*  `{{$('Summarise Pod').item.json.ready_containers}}` \u00b7 *Restarts*  `{{$('Summarise Pod').item.json.restart_count}}`\n*State*  {{$('Summarise Pod').item.json.container_state}}\n*Last term.*  `{{$('Summarise Pod').item.json.last_termination_reason}}`\n*Images*  {{$('Summarise Pod').item.json.images}}\n\n\ud83e\udd16 *AI diagnosis*\n\u2022 *Category:*  `{{$json.ai.category || 'n/a'}}` (confidence `{{$json.ai.confidence || 'n/a'}}`)\n\u2022 *Root cause:*  {{$json.ai.root_cause || 'n/a'}}\n\u2022 *Impact:*  {{$json.ai.impact || 'n/a'}}\n\u2022 *Proposed fix:*  `{{$json.ai.fix_command || 'n/a'}}`\n\n_Waits up to 24h for your decision._\n\n\ud83d\udc64 *Sign-off \u2014 one click:*\n\u2022 \u2705 <{{$execution.resumeUrl}}&a=approve|APPROVE \u2014 apply the fix>\n\u2022 \u274c <{{$execution.resumeUrl}}&a=reject|REJECT \u2014 do nothing>\n_Waits up to 24h for your decision._\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "unfurlLinks": false,
          "unfurlMedia": false
        }
      },
