    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "text": "=\u2705 *Fix approved by human \u2014 recording*\n*Pod:*  `{{$('Parse Slack Command').item.json.pod}}` (ns `{{$('Parse Slack Command').item.json.ns}}`)\n*Command to run:*\n```\n{{$('Parse AI Output').item.json.ai.fix_command || 'n/a'}}\n```\n_Autonomous execution disabled \u2014 copy the command above to your kubectl shell. AIPP has logged this approval in the audit trail._\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "b9cf4090-6e56-564d-8d5a-700a184e32b5",
      "name": "Slack \u00b7 Approved \u00b7 Post Fix",
