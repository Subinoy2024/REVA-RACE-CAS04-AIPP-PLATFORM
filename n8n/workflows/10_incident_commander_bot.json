              "role": "user",
              "content": "Service: {{$('1. Accept').item.json.service}}\nMap: {\"api-*\":\"backend-team\",\"web-*\":\"frontend-team\",\"payments-*\":\"platform\"}\nDiagnostics: {{JSON.stringify($('3. Check K8s Prod Pods').item.json)}}"
