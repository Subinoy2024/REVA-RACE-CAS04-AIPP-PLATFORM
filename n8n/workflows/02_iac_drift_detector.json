    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "tf-1",
              "name": "count",
              "value": "={{ ($json.tree || []).filter(i => (i.path || '').endsWith('.tf')).length }}",
              "type": "number"
            },
            {
              "id": "tf-2",
              "name": "files",
              "value": "={{ ($json.tree || []).filter(i => (i.path || '').endsWith('.tf')).slice(0, 20).map(f => f.path) }}",
              "type": "array"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "be9ac444-ffee-5c5c-b47d-aaafac7c035b",
