          "conditions": [
            {
              "id": "if-1",
              "leftValue": "={ $('Intake Form').item.json['Target'] === 'proxmox' }",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
