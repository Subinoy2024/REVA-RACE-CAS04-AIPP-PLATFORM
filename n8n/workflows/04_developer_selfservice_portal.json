      "id": "c18701e8-2c18-5943-a28a-1303e392fe22",
      "name": "Init Trace",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        380,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You size VMs from natural-language workload descriptions. Output ONLY a raw JSON object (no markdown, no prose). Schema: {\"cpu\":<int>, \"memory_gb\":<int>, \"disk_gb\":<int>, \"os\":\"ubuntu|windows\", \"notes\":\"<one line>\"}. Cap at 8 CPU / 32 GB RAM / 200 GB disk."
            },
            {
              "role": "user",
              "content": "Target: {{$json['Target']}}\nWorkload: {{$json['Workload description']}}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "4090ba4e-2e73-51af-bfd8-8055ac8d3726",
      "name": "AI \u00b7 Size the VM",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        560,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account 4"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ai-parse",
              "name": "ai",
              "value": "={{ JSON.parse($json.message?.content || $json.content || $json.text || '{}') }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "bf53a90c-beb1-5e66-8bb1-279a4dbcaaa2",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "aipp",
          "mode": "name"
        },
        "jsonParameters": true,
        "blocks": "=[{\"type\": \"header\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\ud83d\\udcbb  VM Provisioning \\u2014 Approval Needed\", \"emoji\": true}}, {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": \"\\u2022 *Requester:*  `{{$('Intake Form').item.json['Requester email']}}`\\n\\u2022 *Target:*  `{{$('Intake Form').item.json['Target']}}`\\n\\u2022 *Workload:*  {{$('Intake Form').item.json['Workload description']}}\\n\\u2022 *AI-sized:*  cpu=`{{$json.ai.cpu || '?'}}` mem=`{{$json.ai.memory_gb || '?'}}G` disk=`{{$json.ai.disk_gb || '?'}}G` os=`{{$json.ai.os || '?'}}`\\n\\u2022 *Notes:*  {{$json.ai.notes || 'n/a'}}\"}}, {\"type\": \"actions\", \"block_id\": \"aipp_hitl_approval\", \"elements\": [{\"type\": \"button\", \"action_id\": \"approve\", \"style\": \"primary\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u2705  Approve\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\", \"confirm\": {\"title\": {\"type\": \"plain_text\", \"text\": \"Confirm approval\"}, \"text\": {\"type\": \"mrkdwn\", \"text\": \"This will resume the parked n8n execution and apply the proposed change. Continue?\"}, \"confirm\": {\"type\": \"plain_text\", \"text\": \"Yes, apply\"}, \"deny\": {\"type\": \"plain_text\", \"text\": \"Cancel\"}}}, {\"type\": \"button\", \"action_id\": \"reject\", \"style\": \"danger\", \"text\": {\"type\": \"plain_text\", \"text\": \"\\u274c  Reject\", \"emoji\": true}, \"value\": \"{{$execution.resumeUrl}}\"}]}, {\"type\": \"context\", \"elements\": [{\"type\": \"mrkdwn\", \"text\": \"Buttons require the AIPP Slack bridge \\u2014 if a click does nothing, fall back to the resume link below.\"}]}]",
        "text": "=*\ud83d\udcbb  VM Provisioning \u2014 Approval Needed*\n\n\u2022 *Requester:*  `{{$('Intake Form').item.json['Requester email']}}`\n\u2022 *Target:*  `{{$('Intake Form').item.json['Target']}}`\n\u2022 *Workload:*  {{$('Intake Form').item.json['Workload description']}}\n\u2022 *AI-sized:*  cpu=`{{$json.ai.cpu || '?'}}` mem=`{{$json.ai.memory_gb || '?'}}G` disk=`{{$json.ai.disk_gb || '?'}}G` os=`{{$json.ai.os || '?'}}`\n\u2022 *Notes:*  {{$json.ai.notes || 'n/a'}}\n\n\ud83d\udc64 *Sign-off \u2014 one click:*\n\u2022 \u2705 <{{$execution.resumeUrl}}&a=approve|APPROVE \u2014 apply the fix>\n\u2022 \u274c <{{$execution.resumeUrl}}&a=reject|REJECT \u2014 do nothing>\n_Waits up to 24h for your decision._\n\n_trace: `{{ $('Init Trace').item.json.traceId || 'n/a' }}`_",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "unfurlLinks": false,
          "unfurlMedia": false
        }
      },
