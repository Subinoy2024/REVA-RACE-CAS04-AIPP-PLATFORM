          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Find genuinely NEW patterns. Output JSON: {anomalies:[{pattern, severity, first_seen}], recommended_alerts[]}."
            },
            {
              "role": "user",
              "content": "{{JSON.stringify($json.tables?.[0]?.rows || [])}}"
