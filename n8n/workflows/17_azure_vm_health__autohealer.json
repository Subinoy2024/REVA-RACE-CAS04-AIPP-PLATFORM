        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an Azure SRE Monitor. From the resource groups list, evaluate VM health for vm-aipp-sre-demo. Output: {status: 'healthy'|'degraded', cpu_percent: number, memory_percent: number, action_required: bool, recommendation: string}"
            },
            {
              "role": "user",
              "content": "{{JSON.stringify($json)}}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "fee7966d-1c4b-5628-8516-be24b7dcde39",
